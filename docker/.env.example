# 复制成仓库根目录的 .env 再改
#   cp docker/.env.example .env

# 宿主机上 models/ 的绝对路径（里面放 Veason-R1 / RSI-Jev / sam2*.pt / yoloe*.pt ...）
MODELS_DIR=/absolute/path/to/VeasonHarness/models

# 放视频的目录
DATA_DIR=/absolute/path/to/videos

# ④ 决策用的视觉模型 key（deepseek-flash 实测能吃图；deepseek-v4-pro 不吃图）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 走硅基流动的话用这组（可选）
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
